# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token

# Access control
ADMIN_USERS=123456789

# AI Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# Web server
APP_URL=http://localhost:3000
PORT=3000

# PostHog analytics (optional; off when POSTHOG_API_KEY is empty)
# See docs/adr/0001-posthog-integration.md for what is sent.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Required with a key: Telegram IDs are sent only as an HMAC keyed with this
POSTHOG_ID_SECRET=
# production on Railway; tags every event so test-bot events can be filtered out
POSTHOG_ENVIRONMENT=development

# Feature flags
FEATURE_CACHING=true
FEATURE_LOCAL_FOOD_DB=false

# Timing (ms)
REMINDER_CHECK_INTERVAL=60000
PENDING_RETRY_INTERVAL=300000
CONVERSATION_TIMEOUT=600000
